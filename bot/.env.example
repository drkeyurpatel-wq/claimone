# ClaimOne portal bot — copy to .env on the mini PC (chmod 600 .env)

# ─── ClaimOne (Supabase) ───
# The bot signs in as a normal user whose clm_user_profiles.role = 'bot'.
# Never put the service-role key here; the bot refuses to start if it sees one.
SUPABASE_URL=
SUPABASE_ANON_KEY=
BOT_EMAIL=
BOT_PASSWORD=

# clm_centres.id of the hospital this machine sits in (required)
CENTRE_ID=

# ─── Portal logins (one per payer; prefix = env_prefix in tpa-configs) ───
HDFC_USERNAME=
HDFC_PASSWORD=
MEDIASSIST_USERNAME=
MEDIASSIST_PASSWORD=
ABHI_USERNAME=
ABHI_PASSWORD=

# ─── Settings ───
HEADLESS=true      # false to watch the browser while verifying a portal config
LOG_LEVEL=info
NODE_ENV=production

# Optional: path to an already-installed Chromium (otherwise Playwright's own)
CHROMIUM_PATH=
