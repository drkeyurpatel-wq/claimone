# Supabase — use the ANON key only. Never put the service-role key in this app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# WhatsApp Cloud API (optional — notifications are logged even when unset)
WHATSAPP_API_URL=
WHATSAPP_ACCESS_TOKEN=

# Reading settlement letters (PDF / photo / email text) on the Weekly payments page.
# Server-side only. Excel uploads work without it.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# NHCX (leave empty until the hospital is registered; the desks then record "sent on the website")
NHCX_ENV=sandbox                 # sandbox | production
NHCX_PARTICIPANT_CODE=           # e.g. 1000004446@hcx — also set clm_centres.nhcx_participant_code for the centre
NHCX_HFR_ID=
NHCX_PROVIDER_NAME=
NHCX_CLIENT_ID=                  # ABDM gateway client
NHCX_CLIENT_SECRET=
NHCX_PRIVATE_KEY=                # RSA private key PEM, newlines as \n (its certificate is the one registered on NHCX)
NHCX_CALLBACK_SECRET=            # 32+ random characters; the same value set once with clm_set_nhcx_secret()
# Callback URL to register on NHCX: https://<site>/api/nhcx
